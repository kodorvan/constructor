[Unit]
Description=Telegram chat-robot: @robot_bot

Wants=network.target
After=syslog.target network-online.target

[Service]
ExecStart=sudo -u www-data /usr/bin/php /var/www/constructor/kodorvan/constructor/system/public/telegram.php
PIDFile=/var/run/php/telegram.pid
RemainAfterExit=no
RuntimeMaxSec=3600s
Restart=always
RestartSec=5s

[Install]    
WantedBy=multi-user.target
